# PRTG

# URL của API PRTG
PRTG_URL=https://100.102.202.43

# Username PRTG dùng để auth API
PRTG_USER=openclaw_api_reporter

# Mật mã để auth API của PRTG
PRTG_PASSHASH=1199706781
PRTG_VERIFY_TLS=false

# InfluxDB init
DOCKER_INFLUXDB_INIT_MODE=setup

# Username dùng để khởi tạo 
DOCKER_INFLUXDB_INIT_USERNAME=admin

# Password dùng để khởi tạo
DOCKER_INFLUXDB_INIT_PASSWORD=OpenClawAdmin123

# Tên organization, cần phải giống với tên org trong phần collector và khi setup datasource ở Grafana
DOCKER_INFLUXDB_INIT_ORG=openclaw

# Tên bucket, cần match với collector
DOCKER_INFLUXDB_INIT_BUCKET=prtg

# Token, cần match với collector
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=grafana

# Collector

# URL của DB
INFLUX_URL=http://influxdb:8086

# Tên org, cần match với DB
INFLUX_ORG=openclaw

# Tên bucket, cần match với DB
INFLUX_BUCKET=prtg

# Token, cần match với DB
INFLUX_TOKEN=grafana